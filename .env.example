# Copy to .env locally. In Streamlit Cloud, use Settings > Secrets.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-5
DATABASE_URL=sqlite:///vigil_ai.db
DEMO_MODE=true
# Optional password. Required when DEMO_MODE=false. Do not commit a real password.
DEMO_PASSWORD=
MAX_LLM_CALLS_PER_DAY=200
